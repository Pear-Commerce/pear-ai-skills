{
  "manifest_version": 3,
  "name": "OpenCode Chrome Bridge",
  "version": "1.0.0",
  "description": "Connects Chrome to opencode via the local chrome-bridge host (opencode plugin or standalone daemon).",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Bridge"
  },
  "key": ""
}